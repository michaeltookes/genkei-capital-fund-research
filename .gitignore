# Python cache and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Generated DeFiLlama artifacts
/data/raw/defillama/**
/data/normalized/defillama/**
/reports/daily/*.md

# Keep directory anchors
!/data/raw/defillama/
!/data/raw/defillama/.gitkeep
!/data/normalized/defillama/
!/data/normalized/defillama/.gitkeep
!/reports/daily/
!/reports/daily/.gitkeep

# Local OS/editor noise
.DS_Store
*.swp

# Local environment files — never commit, see .env.example
.env
.env.*
.envrc
!.env.example

# Claude Code local settings (user-specific permissions, not shared)
.claude/settings.local.json

# Cursor MCP project config can contain database connection secrets.
.cursor/mcp.json

# Jupyter notebook checkpoints (B-054 experiments layer)
.ipynb_checkpoints/
