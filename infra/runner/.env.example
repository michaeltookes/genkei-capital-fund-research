# Self-hosted GH Actions runner config (B-077). Copy to .env on the
# Beelink alongside docker-compose.yml. Never commit the populated file.

# GitHub repo URL the runner registers against.
REPO_URL=https://github.com/michaeltookes/genkei-capital-fund-research

# Fine-grained PAT scoped to this single repo with the
# "Administration: Read and write" permission so the image can mint
# short-lived registration tokens. Rotate per the schedule in
# docs/infrastructure.md.
ACCESS_TOKEN=ghp_replace_me

# Stable name shown in Settings → Actions → Runners. Pick something
# location-aware so a future second runner is unambiguous.
RUNNER_NAME=beelink-genkei-1
